# ======================================================================================
# Coinzeye backend — every setting. Copy to backend/.env (local) or set as Railway variables.
# NEEDS = the developer must supply a real value before launch.
# ======================================================================================

# ---- Core ----------------------------------------------------------------------------
APP_ENV=production                    # production | development | test
BRAND_NAME=Coinzeye                   # shown in emails/WhatsApp/checkout; the web brand is frontend/src/brand.js
PUBLIC_BASE_URL=https://example.com   # NEEDS: the live URL
MONGO_URL=mongodb+srv://...           # NEEDS: MongoDB Atlas connection string
DB_NAME=coinzeye
JWT_SECRET=                           # NEEDS: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
OTP_SECRET=                           # optional; defaults to JWT_SECRET
COOKIE_SECURE=true                    # false only for local http
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=                        # optional
CORS_ORIGINS=                         # only if the frontend is served from another origin
LOG_LEVEL=INFO
SENTRY_DSN=                           # optional
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---- Admin ---------------------------------------------------------------------------
ADMIN_PHONES=+91XXXXXXXXXX            # NEEDS: owner numbers (comma-separated) that get admin on OTP login
ADMIN_EMAIL=                          # optional staff login (seeded on startup)
ADMIN_PASSWORD=                       # optional staff login password

# ---- Jobs ----------------------------------------------------------------------------
WEB_CONCURRENCY=2                     # web worker processes (Dockerfile default 2). A Mongo lock runs each job once.
INPROCESS_SCHEDULER=true              # true: the app runs its own schedule (safe with several workers)
INGEST_KEY=                           # NEEDS if an external cron calls POST /api/jobs/tick (X-Ingest-Key)

# ---- QA (never in production) ---------------------------------------------------------
QA_MODE=false                         # true: all vendors fake, sample content, /api/qa/login, OTP shown on screen
# ENABLE_API_DOCS=false                 true: serve /api/docs and /api/openapi.json in production (always on in QA mode)
OTP_TEST_NUMBERS=                     # optional fixed codes for app reviewers: +919999900001:246810,...

# ---- Login codes (OTP) ----------------------------------------------------------------
# WhatsApp-only is supported: set AISENSY_* and leave MSG91_* empty. WhatsApp is then used even if the
# Admin › Features switch is off, and the login screen hides "Send by SMS instead".
MSG91_AUTH_KEY=                       # NEEDS (SMS): MSG91 auth key
MSG91_OTP_TEMPLATE_ID=                # NEEDS (SMS): DLT-approved OTP template id
AISENSY_API_KEY=                      # NEEDS (WhatsApp OTP + alerts): AiSensy API key
AISENSY_OTP_CAMPAIGN=otp              # exact name of the AiSensy API campaign on the approved Authentication template
OTP_WHATSAPP_ENABLED=false            # default for Admin › Features › WhatsApp OTP (true = WhatsApp first when SMS also exists)
OTP_PROVIDER_MODE=live                # live | console (console = dev only)
OTP_BREAKER_FAILURES=5                # WhatsApp/SMS failures in a row before that channel is skipped (auto mode)…
OTP_BREAKER_COOL_S=60                 # …for this many seconds, so codes go straight to the other channel

# ---- WhatsApp alerts (optional; inbox alerts always work) ----------------------------
# One AiSensy API campaign per alert kind (1 body param = alert text, 1 URL-button param = app path).
# Defaults are alert_<kind>; override with AISENSY_CAMPAIGN_<KIND>, e.g.:
AISENSY_CAMPAIGN_VERDICT_CHANGED=
AISENSY_CAMPAIGN_CRASH=
AISENSY_CAMPAIGN_AUTOPILOT=
AISENSY_CAMPAIGN_BASKET_CHANGE=

# ---- Payments (Razorpay Subscriptions) -------------------------------------------------
RAZORPAY_KEY_ID=                      # NEEDS
RAZORPAY_KEY_SECRET=                  # NEEDS
RAZORPAY_WEBHOOK_SECRET=              # NEEDS: webhook → <PUBLIC_BASE_URL>/api/billing/razorpay/webhook
RAZORPAY_PLAN_LITE=                   # NEEDS: Razorpay plan id at ₹2,360/month (₹2,000 + 18% GST)
RAZORPAY_PLAN_PRO=                    # NEEDS: Razorpay plan id at ₹5,900/month (₹5,000 + 18% GST)

# ---- AI (Anthropic) ------------------------------------------------------------------
ANTHROPIC_API_KEY=                    # NEEDS: verdicts, debate, X-Ray headlines, Ask Deepak, Chart Reader, News
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5
LLM_MODEL_VISION=claude-opus-5-5
# AI queues: one pool per model class per worker, so Chart Reader bursts don't starve X-Ray / Ask. Size
# (pool size × WEB_CONCURRENCY) against your Anthropic rate limits. Watch Admin › Vendors › AI queues live.
LLM_MAX_CONCURRENCY=32                # default size of each pool
# LLM_MAX_CONCURRENCY_FAST= / _STRONG= / _VISION=      per-pool override
# LLM_QUEUE_WAIT_S_FAST=15 / _STRONG=15 / _VISION=45   seconds a call may wait for a slot before "try again"
# LLM_TIMEOUT_S=                      hard timeout per call (default 25 s; 45 s for vision)
LLM_EFFORT=low                        # thinking depth for the app's short JSON tasks (low keeps replies inside max_tokens)

# ---- Market data ------------------------------------------------------------------------
# Prices + daily history (verdicts, forecasts, What If, Paper Money, hit-rate scoring) come from Twelve Data when a key
# is set; coin details, rankings, market totals and trending always come from CoinGecko (Twelve Data has none of them).
TWELVE_DATA_API_KEY=                  # NEEDS for Twelve Data prices (also used for USD/INR)
MARKET_PRICE_SOURCE=                  # empty = Twelve Data if the key is set, else CoinGecko; or force coingecko | twelvedata
TWELVE_DATA_CREDITS_PER_MIN=8         # your plan's credits a minute (Basic 8 + 800/day cap; Grow 55+). Split across WEB_CONCURRENCY workers
TWELVE_DATA_MAX_WAIT_S=3              # wait this long for credits, then fetch that coin from CoinGecko instead
COINGECKO_API_KEY=                    # optional (higher rate limits). Demo keys use api.coingecko.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3   # pro keys: https://pro-api.coingecko.com/api/v3
COINGECKO_RATE_PER_MIN=               # calls/min per worker; default 12 (free tier ~30/min per IP, 2 workers), 400 on pro-api.
                                      # Over budget or after a 429 the app serves the last cached value instead of calling.
USDINR_FALLBACK=88.0
KRONOS_API_URL=                       # optional: Bullzeye's Kronos service URL (else a statistical forecast)
KRONOS_API_KEY=
TOKEN_UNLOCKS_API_KEY=                # NEEDS (later): token-unlock data vendor; until then add unlocks in Admin › Events

# ---- Exchanges (users' own keys are stored encrypted) -----------------------------------
EXCHANGE_VAULT_KEY=                   # NEEDS: Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
                                      # NEEDS before public launch: move the master key to a KMS (crypto/vault.py wrap/unwrap)
BINANCE_API_BASE=https://api.binance.com
KUCOIN_API_BASE=https://api.kucoin.com

# ---- Tuning (optional; defaults are what the load test used) ----------------------------
# XRAY_CACHE_SECONDS=600  ASK_CACHE_SECONDS=3600  ANON_XRAY_PER_IP_DAY=1000  OTP_MAX_PER_IP_HOUR=1000
# ANON_XRAY_NOCOOKIE_PER_IP_DAY=30   logged-out checks a day per network for requests without a valid visitor cookie
# TRUSTED_PROXY_HOPS=0              public proxies in front of Railway that append to X-Forwarded-For (Cloudflare = 1).
#                                   The visitor IP is the first public X-Forwarded-For entry from the right after
#                                   skipping internal hops and this many proxies; anything to its left can be forged.
# LOG_CLIENT_IP=false               true: log the raw X-Forwarded-For and the chosen IP (turn off once checked)
# CLIENT_IP_HEADER=                 set only if a proxy in front overwrites a header on every request (e.g. cf-connecting-ip)
# AUTOPILOT_CONCURRENCY=10  HTTP_MAX_CONNECTIONS=100  COINGECKO_MAX_WAIT_S=4
# JOB_API_WAIT_S=90   scheduled jobs wait up to this long for CoinGecko / Twelve Data budget (pages don't wait)

# ---- Vendor switches (live | fake | off). Unset = live when keys are present. -------------
# MARKET_MODE= GOPLUS_MODE= NEWS_MODE= P2P_MODE= RAZORPAY_MODE= AISENSY_MODE= ANTHROPIC_MODE= KRONOS_MODE=
# EXCHANGE_BINANCE_MODE= EXCHANGE_KUCOIN_MODE=      (fake is refused in production)
